# Copy to .env. The git-only snapshot needs none of these; Jira and GitHub enrichment are skipped when unset.
# Repo clones default to ~/Dev/spacetoco-app and ~/Dev/spacetoco-api.
APP_REPO_PATH=
API_REPO_PATH=

# Jira: a scoped API token (classic scope read:jira-work) from id.atlassian.com → Security → API tokens.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=spacetoco.atlassian.net
JIRA_PROJECTS=DEV,BUG
# Optional: skips the cloudId lookup.
JIRA_CLOUD_ID=

# GitHub: any token that can read pull requests in spacetoco/spacetoco-app and spacetoco/spacetoco-api.
# Locally, without switching accounts: GITHUB_TOKEN=$(gh auth token --user lukedavies-spacetoco)
GITHUB_TOKEN=
